{
    "title": "Resume",
    "name": "startbootstrap-resume",
    "version": "7.0.3",
    "scripts": {
        "build": "npm run clean && npm run build:scss && npm run build:scripts && npm run build:assets",
        "build:assets": "node scripts/render-assets.js",
        "build:scripts": "node scripts/render-scripts.js",
        "build:scss": "node scripts/render-scss.js",
        "clean": "node scripts/clean.js",
        "start": "npm run build && node scripts/start.js"
    },
    "homepage": "https://startbootstrap.com/theme/resume",
    "license": "MIT",
    "author": "Start Bootstrap",
    "dependencies": {
        "bootstrap": "5.1.0"
    },
    "devDependencies": {
        "autoprefixer": "10.3.1",
        "browser-sync": "2.27.5",
        "chokidar": "3.5.2",
        "concurrently": "6.2.0",
        "postcss": "8.3.6",
        "sass": "1.37.5"
    }
}
